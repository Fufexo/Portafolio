---
/**
 * Texto bilingüe: renderiza la versión del idioma de la página actual
 * (Astro.currentLocale: '/about' → español, '/en/about' → inglés).
 *
 *   <LocalizedText as="h2" text={{ es: 'Hola', en: 'Hello' }} class="text-2xl" />
 */
import type { HTMLTag, Polymorphic } from 'astro/types';
import { getLang, type Localized } from '../i18n/ui';

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  text: Localized;
};

const { as: Tag = 'span', text, ...attrs } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<Tag {...attrs}>{text[lang]}</Tag>
