---
import { ui } from '../i18n/ui';
import { navItems } from '../data/nav';
const es = ui.es;
const en = ui.en;
---

<header class="fixed top-0 w-full z-50 bg-background/70 backdrop-blur-xl border-b border-outline-variant/10" transition:persist>
  <div class="flex justify-between items-center max-w-7xl mx-auto px-4 sm:px-8 py-2 sm:py-4">
    <a href="/" class="flex items-center min-h-11 text-lg sm:text-2xl font-black tracking-tighter text-on-surface shrink-0">
      {es.brand}
    </a>

    <nav
      class="hidden md:flex items-center gap-8"
      aria-label={es['nav.main.label']}
      data-aria-es={es['nav.main.label']}
      data-aria-en={en['nav.main.label']}
    >
      {navItems.map(({ labelKey, href }) => (
        <a
          href={href}
          data-nav-link
          data-nav-href={href}
          class="relative py-2 text-sm font-medium transition-colors duration-200 text-on-surface-variant hover:text-primary"
        >
          <span
            data-i18n
            data-es={es[labelKey as keyof typeof es]}
            data-en={en[labelKey as keyof typeof en]}
          >{es[labelKey as keyof typeof es]}</span>
          <span
            data-nav-underline
            class="absolute bottom-0 left-0 h-0.5 rounded-full transition-all duration-300 w-0 bg-primary"
          />
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <button
        type="button"
        data-theme-toggle
        aria-label={es['nav.theme.label']}
        data-aria-es={es['nav.theme.label']}
        data-aria-en={en['nav.theme.label']}
        class="w-11 h-11 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors duration-200 flex items-center justify-center"
      >
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true" data-theme-icon style="font-variation-settings:'FILL' 1">dark_mode</span>
      </button>
      <button
        type="button"
        data-lang-toggle
        aria-label={es['nav.lang.label']}
        data-aria-es={es['nav.lang.label']}
        data-aria-en={en['nav.lang.label']}
        class="w-11 h-11 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container text-xs sm:text-sm font-bold tracking-widest transition-colors duration-200"
      >
        EN
      </button>
      <a
        href="/resume.pdf"
        download
        data-i18n
        data-es={es['nav.resume']}
        data-en={en['nav.resume']}
        class="ml-1 primary-gradient-glow text-on-primary font-bold text-xs sm:text-sm px-4 sm:px-6 min-h-11 inline-flex items-center rounded-md transition-all duration-300 active:scale-95 shadow-glow whitespace-nowrap"
      >
        {es['nav.resume']}
      </a>
    </div>
  </div>
</header>
