---
/**
 * Stack tecnológico de un proyecto: selector de tecnologías (pestañas) + panel de detalle.
 * - Las tarjetas no se mueven al seleccionar: solo cambia el panel de abajo.
 * - Todos los paneles comparten la misma celda de grid, así la altura es estable
 *   (la del panel más alto) y el cambio es un fundido sin saltos de layout.
 * - Patrón ARIA de pestañas: flechas, Inicio y Fin para moverse con teclado.
 */
import type { CollectionEntry } from 'astro:content';
import LocalizedText from './LocalizedText.astro';
import { t } from '../i18n/ui';

type StackItem = CollectionEntry<'projects'>['data']['stack'][number];

interface Props {
  id: string;
  items: StackItem[];
  liveUrl: string;
}

const { id, items, liveUrl } = Astro.props;

const toneClass = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
} as const;

/** Clases del ícono según su tipo; `large` es la versión del panel de detalle. */
function iconClass(icon: StackItem['icon'], large = false) {
  if (icon.kind === 'material') {
    return [
      'material-symbols-outlined',
      large ? 'stack-mat-icon-lg' : 'stack-mat-icon',
      icon.tone ? toneClass[icon.tone] : 'text-on-surface-variant',
    ].join(' ');
  }
  if (icon.kind === 'badge') return large ? 'stack-badge stack-badge-lg' : 'stack-badge';
  return 'stack-symbol select-none';
}

const hint = t('stack.hint');
const tablistLabel = t('stack.tablist.label');
---

<div class="stack-showcase" data-stack-showcase>
  <LocalizedText as="p" text={hint} class="text-sm text-on-surface-variant mb-4" />

  <div
    role="tablist"
    aria-label={tablistLabel.es}
    data-aria-es={tablistLabel.es}
    data-aria-en={tablistLabel.en}
    class="stack-tabs no-scrollbar"
  >
    {items.map((item, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-controls={`${id}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="stack-tab"
      >
        <span class="stack-icon-wrap" aria-hidden="true">
          <span class={iconClass(item.icon)}>{item.icon.value}</span>
        </span>
        <span class="stack-name">{item.name}</span>
        <span class="stack-tagline">{item.tagline}</span>
      </button>
    ))}
  </div>

  <div class="stack-panels">
    {items.map((item, i) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${i}`}
        aria-labelledby={`${id}-tab-${i}`}
        class="stack-panel"
        data-active={i === 0 ? 'true' : 'false'}
        inert={i !== 0}
      >
        <div class="stack-exp-left">
          <span class="stack-icon-wrap stack-icon-lg" aria-hidden="true">
            <span class={iconClass(item.icon, true)}>{item.icon.value}</span>
          </span>
          <h3 class="stack-exp-name">{item.name}</h3>
          <LocalizedText as="p" text={item.description} class="stack-exp-desc" />
        </div>
        <div class="stack-exp-right">
          <LocalizedText as="p" text={t('project.stack.in-project')} class="stack-exp-label" />
          <LocalizedText as="p" text={item.note} class="stack-exp-note" />
          <div class="stack-chips">
            {item.chips.map((chip) => <span class="stack-chip">{chip}</span>)}
          </div>
          {item.showLiveLink && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 mt-4 min-h-11 text-sm font-bold text-primary hover:text-on-surface transition-colors"
            >
              <LocalizedText text={t('project.cta.live')} />
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_outward</span>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    function select(root, tab, focus) {
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (!panel) return;
        panel.setAttribute('data-active', on ? 'true' : 'false');
        if (on) panel.removeAttribute('inert');
        else panel.setAttribute('inert', '');
      });
      if (focus) tab.focus();
      // En móvil, centra la pestaña elegida dentro de la fila deslizable
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    }

    function init() {
      document.querySelectorAll('[data-stack-showcase]').forEach(function (root) {
        if (root.dataset.bound === '1') return;
        root.dataset.bound = '1';
        var list = root.querySelector('[role="tablist"]');

        list.addEventListener('click', function (e) {
          var tab = e.target.closest('[role="tab"]');
          if (tab) select(root, tab, false);
        });

        list.addEventListener('keydown', function (e) {
          var tabs = Array.prototype.slice.call(list.querySelectorAll('[role="tab"]'));
          var i = tabs.indexOf(document.activeElement);
          if (i < 0) return;
          var next = null;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = tabs[(i + 1) % tabs.length];
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = tabs[(i - 1 + tabs.length) % tabs.length];
          else if (e.key === 'Home') next = tabs[0];
          else if (e.key === 'End') next = tabs[tabs.length - 1];
          if (!next) return;
          e.preventDefault();
          select(root, next, true);
        });
      });
    }

    if (!window.__stackShowcaseBound) {
      window.__stackShowcaseBound = true;
      document.addEventListener('astro:page-load', init);
    }
    init();
  })();
</script>

<style>
  /* ── Selector ─────────────────────────────────────────── */
  .stack-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    margin: 0 -1rem 1rem;
    padding: 0.25rem 1rem;
  }

  @media (min-width: 640px) {
    .stack-tabs { margin: 0 -2rem 1rem; padding: 0.25rem 2rem; }
  }

  .stack-tabs {
    scroll-snap-type: x proximity;
  }

  .stack-tab {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem 0.5rem 0.625rem;
    border-radius: 999px;
    background: var(--color-surface-container);
    outline: 1px solid color-mix(in srgb, var(--color-outline) 18%, transparent);
    outline-offset: 0;
    color: var(--color-on-surface-variant);
    text-align: left;
    cursor: pointer;
    scroll-snap-align: center;
    transition: background 0.2s, outline-color 0.2s, color 0.2s, box-shadow 0.3s;
  }

  .stack-tab:hover {
    background: var(--color-surface-container-high);
    color: var(--color-on-surface);
  }

  .stack-tab[aria-selected='true'] {
    background: var(--color-surface-container-high);
    outline-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    color: var(--color-on-surface);
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .stack-tab:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .stack-icon-wrap {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Íconos (ver iconClass en el frontmatter) */
  .stack-symbol { font-size: 1.1rem; color: var(--color-on-surface-variant); }
  .stack-mat-icon { font-size: 20px; }
  .stack-mat-icon-lg { font-size: 44px; }
  .stack-icon-lg .stack-symbol { font-size: 2rem; }

  .stack-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background: color-mix(in srgb, var(--color-brand-typescript) 20%, transparent);
    border-radius: 0.375rem;
    font-weight: 900;
    font-size: 0.6rem;
    color: var(--color-brand-typescript);
  }
  .stack-badge.stack-badge-lg {
    width: 3rem;
    height: 3rem;
    font-size: 1rem;
    border-radius: 0.5rem;
  }

  .stack-name {
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }

  .stack-tagline { display: none; }

  /* Desde desktop: tarjetas en grid, todas en una sola fila.
     Por debajo, fila deslizable de chips (evita filas con tarjetas huérfanas). */
  @media (min-width: 1024px) {
    .stack-tabs {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
      gap: 0.75rem;
      overflow: visible;
      margin: 0 0 1rem;
      padding: 0;
    }

    .stack-tab {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
      padding: 1.25rem;
      border-radius: 0.75rem;
    }

    .stack-icon-wrap { width: 2.5rem; height: 2.5rem; margin-bottom: 0.25rem; }
    .stack-symbol { font-size: 1.5rem; }
    .stack-mat-icon { font-size: 28px; }
    .stack-badge { width: 2rem; height: 2rem; font-size: 0.7rem; }
    .stack-name { font-size: 1.05rem; white-space: normal; }

    .stack-tagline {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.4;
      color: var(--color-on-surface-variant);
      opacity: 0.8;
    }

    /* Indicador inferior en la tarjeta seleccionada */
    .stack-tab::after {
      content: '';
      position: absolute;
      left: 1.25rem;
      right: 1.25rem;
      bottom: 0;
      height: 2px;
      border-radius: 999px;
      background: var(--color-primary);
      transform: scaleX(0);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .stack-tab[aria-selected='true']::after { transform: scaleX(1); }
  }

  /* ── Panel de detalle ─────────────────────────────────── */
  .stack-panels {
    display: grid;
    border-radius: 0.75rem;
    background: var(--color-surface-container-high);
    outline: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .stack-panel {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
  }

  .stack-panel[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.3s ease 0.08s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.08s, visibility 0s;
  }

  @media (min-width: 640px) {
    .stack-panel { padding: 2rem; }
  }

  .stack-exp-left {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1 1 220px;
    max-width: 320px;
  }

  .stack-exp-right {
    flex: 2 1 280px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stack-icon-lg { width: 3.5rem; height: 3.5rem; }

  .stack-exp-name {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-on-surface);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stack-exp-desc {
    font-size: 0.9rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  .stack-exp-label {
    font-size: 0.6875rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .stack-exp-note {
    font-size: 0.95rem;
    color: var(--color-on-surface);
    opacity: 0.85;
    line-height: 1.65;
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .stack-chip {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    color: var(--color-primary);
    border: 1px solid color-mix(in srgb, var(--color-primary) 16%, transparent);
  }
</style>
