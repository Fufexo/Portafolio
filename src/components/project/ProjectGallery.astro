---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import LocalizedText from '../LocalizedText.astro';
import SectionHeading from './SectionHeading.astro';
import { t, getLang } from '../../i18n/ui';

type GalleryItem = CollectionEntry<'projects'>['data']['gallery'][number];

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const lang = getLang(Astro.currentLocale);

/**
 * Cuadrícula de 6 columnas desde tablet:
 * full = ancho completo · half = mitad · wide/narrow = 2/3 + 1/3 (misma fila).
 * En la fila wide/narrow manda la imagen ancha (16:10); la angosta se posiciona
 * absoluta y se recorta dentro, así una captura vertical no estira la fila.
 */
const layout = {
  full:   { col: 'sm:col-span-6', img: 'aspect-21/9',  sizes: '(min-width: 1280px) 1216px, 100vw' },
  half:   { col: 'sm:col-span-3', img: 'aspect-16/10', sizes: '(min-width: 640px) 50vw, 100vw' },
  wide:   { col: 'sm:col-span-4', img: 'aspect-16/10', sizes: '(min-width: 640px) 66vw, 100vw' },
  narrow: { col: 'sm:col-span-2', img: 'max-h-128 sm:max-h-none sm:absolute sm:inset-0 sm:h-full', sizes: '(min-width: 640px) 33vw, 100vw' },
} as const;
---

<section class="bg-surface-container-low py-24 sm:py-32 px-4 sm:px-8 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <SectionHeading eyebrow={t('project.gallery.label')} title={t('project.gallery.title')} />

    <div class="grid grid-cols-1 sm:grid-cols-6 gap-4 sm:gap-6">
      {items.map((item) => (
        <figure class={`gallery-item relative rounded-xl overflow-hidden group ghost-border ${layout[item.span].col}`}>
          <Image
            src={item.image}
            alt={item.alt[lang]}
            widths={[640, 1024, 1600]}
            sizes={layout[item.span].sizes}
            class={`block w-full min-h-45 object-cover object-top transition-transform duration-700 group-hover:scale-105 ${layout[item.span].img}`}
          />
          <figcaption class="gallery-caption">
            <LocalizedText as="h3" text={item.title} class="font-bold text-lg" />
            <LocalizedText as="p" text={item.description} class="text-sm text-on-surface-variant" />
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
