---
import LocalizedText from '../LocalizedText.astro';
import { t } from '../../i18n/ui';

interface Props {
  liveUrl: string;
  accent: 'primary' | 'secondary';
}

const { liveUrl, accent } = Astro.props;
const glowClass = accent === 'secondary' ? 'bg-secondary/8' : 'bg-primary/8';
---

<section class="bg-surface py-28 sm:py-40 px-4 sm:px-8 relative overflow-hidden">
  <div class={`absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-175 h-175 ${glowClass} blur-[100px] rounded-full pointer-events-none`} aria-hidden="true"></div>

  <div class="max-w-3xl mx-auto text-center relative z-10">
    <LocalizedText
      as="h2"
      text={t('project.cta.title')}
      class="text-[clamp(2rem,7vw,4rem)] font-black tracking-tighter leading-tight mb-10"
    />
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href={liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 min-h-12 primary-gradient-glow text-on-primary px-10 rounded-md font-black text-base tracking-tight shadow-glow-cta hover:scale-105 active:scale-95 transition-transform"
      >
        <LocalizedText text={t('project.cta.live')} />
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">arrow_outward</span>
      </a>
      <a
        href="/"
        class="cta-back-btn relative inline-flex items-center min-h-12 overflow-hidden glass-effect text-on-surface px-10 rounded-md font-bold text-base ghost-border transition-all duration-300 hover:scale-[1.03] hover:shadow-glow active:scale-95"
      >
        <LocalizedText text={t('project.cta.back')} />
      </a>
    </div>
  </div>
</section>

<style>
  /* Destello que cruza el botón secundario al hacer hover */
  .cta-back-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, color-mix(in srgb, var(--color-primary) 8%, transparent) 50%, transparent 65%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .cta-back-btn:hover::before {
    transform: translateX(100%);
  }
</style>
