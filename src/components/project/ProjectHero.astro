---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import LocalizedText from '../LocalizedText.astro';
import { t, getLang } from '../../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;
const { hero, accent, title } = project;
const lang = getLang(Astro.currentLocale);

// Clases literales para que Tailwind las detecte
const glowClass = accent === 'secondary' ? 'bg-secondary/8' : 'bg-primary/8';

const meta = [
  { label: t('project.meta.role'), value: hero.role },
  { label: t('project.meta.year'), value: { es: hero.year, en: hero.year } },
  { label: t('project.meta.platform'), value: hero.platform },
];
---

<section class="relative min-h-svh flex flex-col justify-end items-start px-4 sm:px-8 pb-24 sm:pb-32 overflow-hidden">
  <!-- Imagen de fondo -->
  <div class="absolute inset-0 z-0">
    <Image
      src={hero.image}
      alt={hero.imageAlt[lang]}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-top opacity-40"
    />
    <div class="absolute inset-0 bg-linear-to-t from-background via-background/70 to-background/10"></div>
    <div class="absolute inset-0 bg-linear-to-r from-background via-background/40 to-transparent"></div>
  </div>

  <!-- Brillo ambiental -->
  <div class={`absolute top-1/3 left-1/4 w-150 h-150 ${glowClass} blur-[120px] rounded-full pointer-events-none z-0`}></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full pt-32">
    <div class="inline-flex items-center gap-2 mb-6 bg-secondary/10 border border-secondary/30 px-4 py-1.5 rounded-full backdrop-blur-sm shadow-glow-secondary">
      <span class="w-2 h-2 rounded-full bg-secondary shrink-0 animate-pulse" aria-hidden="true"></span>
      <LocalizedText text={hero.badge} class="text-xs uppercase tracking-widest font-bold text-secondary" />
    </div>

    <h1
      class="text-[clamp(3.5rem,14vw,9rem)] font-black tracking-tighter leading-none mb-5 text-on-surface"
      style={`text-shadow: 0 0 60px color-mix(in srgb, var(--color-${accent}) 15%, transparent)`}
    >
      {title}
    </h1>

    <LocalizedText
      as="p"
      text={hero.subtitle}
      class="max-w-xl text-lg sm:text-xl text-on-surface-variant leading-relaxed mb-10"
    />

    <dl class="flex flex-wrap gap-8 sm:gap-12">
      {meta.map(({ label, value }) => (
        <div>
          <LocalizedText as="dt" text={label} class="block text-[11px] uppercase tracking-widest text-secondary font-bold mb-1" />
          <LocalizedText as="dd" text={value} class="text-on-surface font-semibold" />
        </div>
      ))}
    </dl>
  </div>
</section>
