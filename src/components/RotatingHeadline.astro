---
/**
 * Titular con una frase fija + una palabra que se escribe y borra en bucle.
 * - Texto en color sólido: sin background-clip, así ninguna letra se recorta.
 * - Todas las palabras se apilan invisibles en la misma celda de grid para
 *   reservar la altura de la más larga (sin saltos de layout al cambiar).
 * - Lectores de pantalla leen una frase estable (sr-only), no la animación.
 */
import { getLang, type Localized } from '../i18n/ui';

interface Props {
  lead: Localized;
  words: Localized<string[]>;
  class?: string;
}

const { lead, words, class: className = '' } = Astro.props;
const lang = getLang(Astro.currentLocale);
const leadText = lead[lang];
const wordList = words[lang];
---

<h1
  data-rotating-headline
  data-words={JSON.stringify(wordList)}
  class:list={['font-black tracking-tight leading-[1.05] text-on-surface', className]}
>
  <span class="sr-only">{`${leadText} ${wordList[0]}`}</span>

  <span aria-hidden="true" class="block">
    <span class="block">{leadText}</span>

    <span class="grid">
      <!-- Reserva de altura: todas las palabras, invisibles, en la misma celda -->
      {wordList.map((word) => (
        <span class="invisible col-start-1 row-start-1 pr-[0.6em]">{word}</span>
      ))}
      <span class="col-start-1 row-start-1 text-primary">
        <span data-rotating-word>{wordList[0]}</span><span
          class="rotating-caret inline-block w-[0.08em] h-[0.85em] ml-[0.06em] -mb-[0.06em] bg-primary align-baseline"
        ></span>
      </span>
    </span>
  </span>
</h1>

<script>
  import { onPageLoad } from '../scripts/lifecycle';
  const TYPE_MS = 70;
  const DELETE_MS = 35;
  const HOLD_MS = 2200;
  const GAP_MS = 350;

  type Rotator = { stop: () => void };
  const active = new Map<HTMLElement, Rotator>();

  function start(h1: HTMLElement): Rotator | undefined {
    const target = h1.querySelector<HTMLElement>('[data-rotating-word]');
    let words: string[] = [];
    try {
      words = JSON.parse(h1.dataset.words ?? '[]');
    } catch {
      return;
    }
    if (!target || words.length < 2) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let stopped = false;
    target.textContent = words[0];

    const schedule = (fn: () => void, ms: number) => {
      if (!stopped) timer = setTimeout(fn, ms);
    };

    // Con movimiento reducido: cambio directo de palabra, sin tipeo
    function swap() {
      index = (index + 1) % words.length;
      target!.textContent = words[index];
      schedule(swap, HOLD_MS + 1500);
    }

    function erase() {
      const text = target!.textContent ?? '';
      if (text.length > 0) {
        target!.textContent = text.slice(0, -1);
        schedule(erase, DELETE_MS);
      } else {
        index = (index + 1) % words.length;
        schedule(type, GAP_MS);
      }
    }

    function type() {
      const word = words[index];
      const current = target!.textContent ?? '';
      if (current.length < word.length) {
        target!.textContent = word.slice(0, current.length + 1);
        schedule(type, TYPE_MS);
      } else {
        schedule(erase, HOLD_MS);
      }
    }

    schedule(reduce ? swap : erase, reduce ? HOLD_MS + 1500 : HOLD_MS);
    return {
      stop: () => {
        stopped = true;
        clearTimeout(timer);
      },
    };
  }

  function stopAll() {
    active.forEach((r) => r.stop());
    active.clear();
  }

  function initAll() {
    stopAll();
    document.querySelectorAll<HTMLElement>('[data-rotating-headline]').forEach((h1) => {
      const rotator = start(h1);
      if (rotator) active.set(h1, rotator);
    });
  }

  onPageLoad(initAll);
  document.addEventListener('astro:before-swap', stopAll);
  // Pausa cuando la pestaña no está visible (ahorra CPU/batería)
  document.addEventListener('visibilitychange', () => (document.hidden ? stopAll() : initAll()));
</script>
