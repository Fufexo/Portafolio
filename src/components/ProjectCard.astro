---
/**
 * Tarjeta de proyecto de la portada. Recibe la entrada de la colección `projects`.
 * - mobile: tarjeta vertical con imagen arriba.
 * - desktop: celda de la cuadrícula bento (ancho según card.size).
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import LocalizedText from './LocalizedText.astro';
import { t } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  variant: 'mobile' | 'desktop';
  /** La primera tarjeta visible se carga sin lazy loading (mejora el LCP). */
  eager?: boolean;
}

const { project, variant, eager = false } = Astro.props;
const { title, category, card } = project.data;
const href = `/proyectos/${project.id}/`;
const loading = eager ? 'eager' : 'lazy';
const colClass = card.size === 'large' ? 'md:col-span-8' : 'md:col-span-4';
const viewLabel = t('home.project.view');
---

{variant === 'mobile' ? (
  <a
    href={href}
    data-project-card
    data-category={category}
    class="group relative bg-surface-container-low rounded-xl overflow-hidden ghost-border transition-transform duration-200 active:scale-[0.98]"
  >
    <div class="aspect-video relative overflow-hidden">
      <Image
        src={card.image}
        alt={card.imageAlt}
        widths={[400, 800]}
        sizes="100vw"
        loading={loading}
        class={`w-full h-full object-cover ${card.imagePosition}`}
      />
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-surface-container-low to-transparent"></div>
    </div>

    <div class="p-5">
      <ul class="flex flex-wrap gap-2 mb-3">
        {card.tags.map((tag) => (
          <li class="text-[11px] px-2 py-0.5 rounded-sm bg-surface-container-highest text-secondary uppercase tracking-wider font-bold whitespace-nowrap">
            {tag}
          </li>
        ))}
      </ul>
      <h2 class="text-2xl font-bold tracking-tight text-on-surface mb-2">{title}</h2>
      <LocalizedText as="p" text={card.description} class="text-sm text-on-surface-variant leading-relaxed mb-5" />
      <div class="flex justify-between items-center min-h-11 -mb-2">
        <LocalizedText text={viewLabel} class="text-xs font-bold text-primary uppercase tracking-[0.2em]" />
        <span class="material-symbols-outlined text-primary text-xl" aria-hidden="true">arrow_outward</span>
      </div>
    </div>
  </a>
) : (
  <a
    href={href}
    data-project-card
    data-category={category}
    class:list={[colClass, 'group relative overflow-hidden rounded-xl bg-surface-container-low ghost-border transition-all duration-500 hover:bg-surface-container-high hover:-translate-y-1']}
  >
    <div class="p-8 h-full flex flex-col">
      <div class="flex justify-between items-start gap-4 mb-6">
        <div class="min-w-0 flex-1">
          <ul class="flex flex-wrap gap-2 mb-4">
            {card.tags.map((tag) => (
              <li class="text-[11px] px-2 py-0.5 rounded-sm bg-surface-container text-on-surface-variant font-bold tracking-wider uppercase whitespace-nowrap">
                {tag}
              </li>
            ))}
          </ul>
          <h2 class="text-4xl font-bold tracking-tight text-on-surface group-hover:text-primary transition-colors duration-300">{title}</h2>
          <LocalizedText as="p" text={card.description} class="text-on-surface-variant text-sm mt-2" />
        </div>
        <span
          class="material-symbols-outlined text-primary text-4xl shrink-0 opacity-40 -translate-x-1 translate-y-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300"
          aria-hidden="true"
        >
          arrow_outward
        </span>
      </div>
      <div class="flex-1 min-h-64 overflow-hidden rounded-lg">
        <Image
          src={card.image}
          alt={card.imageAlt}
          widths={card.size === 'large' ? [800, 1200] : [400, 800]}
          sizes={card.size === 'large' ? '(min-width: 1280px) 800px, 66vw' : '(min-width: 1280px) 400px, 33vw'}
          loading={loading}
          class={`w-full h-full object-cover ${card.imagePosition} saturate-[0.85] group-hover:saturate-100 group-hover:scale-[1.03] transition-all duration-700`}
        />
      </div>
    </div>
  </a>
)}
