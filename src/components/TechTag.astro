---
interface Props {
  label: string;
  icon: string;
  delay?: string;
}
const { label, icon, delay = '0s' } = Astro.props;
---
<span
  class="tech-tag flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant text-xs font-semibold cursor-default select-none"
  style={`--delay: ${delay}`}
>
  <span class="text-[11px]">{icon}</span>
  {label}
</span>
