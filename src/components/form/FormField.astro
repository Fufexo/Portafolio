---
interface Props {
  id: string;
  label: string;
  wrapperClass?: string;
}

const { id, label, wrapperClass = 'flex flex-col gap-3 group' } = Astro.props;
---

<div class={wrapperClass}>
  <label
    class="text-xs font-bold uppercase tracking-wider text-on-surface-variant group-focus-within:text-primary transition-colors"
    for={id}
  >
    {label}
  </label>
  <slot />
</div>
