---
import { ui } from '../i18n/ui';
const es = ui.es;
const en = ui.en;

const navItems = [
  { labelEs: es['nav.projects'], labelEn: en['nav.projects'], icon: 'grid_view', href: '/' },
  { labelEs: es['nav.about'],    labelEn: en['nav.about'],    icon: 'person',    href: '/about' },
  { labelEs: es['nav.contact'],  labelEn: en['nav.contact'],  icon: 'mail',      href: '/contact' },
];
---

<nav
  id="bottom-nav"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center space-x-2 bg-[#201F22]/60 backdrop-blur-lg rounded-full px-4 sm:px-6 py-2 sm:py-3 shadow-[0_20px_40px_rgba(0,0,0,0.4)] ghost-border transition-all duration-300"
  transition:persist
>
  {navItems.map(({ labelEs, labelEn, icon, href }) => (
    <a
      href={href}
      data-bottom-link
      data-nav-href={href}
      class="px-4 py-2 active:scale-95 duration-300 flex flex-col items-center transition-colors text-[#E5E1E4]/50 hover:text-[#D2BBFF]"
    >
      <span class="material-symbols-outlined" data-nav-icon>
        {icon}
      </span>
      <span
        class="text-[10px] font-medium mt-1"
        data-i18n
        data-es={labelEs}
        data-en={labelEn}
      >
        {labelEs}
      </span>
      <span
        data-nav-dot
        class="block w-4 h-[2px] bg-[#D2BBFF] rounded-full mt-1 shadow-[0_0_6px_#D2BBFF] hidden"
      />
    </a>
  ))}
</nav>

<script is:inline>
  (function () {
    function checkScroll() {
      var nav = document.getElementById('bottom-nav');
      if (!nav) return;
      var scrollBottom = document.documentElement.scrollHeight - window.scrollY - window.innerHeight;
      if (scrollBottom < 120) {
        nav.style.opacity = '0';
        nav.style.pointerEvents = 'none';
        nav.style.marginBottom = '-20px';
      } else {
        nav.style.opacity = '1';
        nav.style.pointerEvents = '';
        nav.style.marginBottom = '0px';
      }
    }

    function init() {
      window.removeEventListener('scroll', checkScroll);
      window.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();
    }

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
  })();
</script>
