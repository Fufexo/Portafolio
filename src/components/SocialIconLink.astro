---
interface Props {
  href: string;
  label: string;
  icon: string;
}

const { href, label, icon } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="social-icon w-11 h-11 flex items-center justify-center rounded-full bg-surface-container text-on-surface-variant ghost-border"
>
  <span class="material-symbols-outlined text-[20px]">{icon}</span>
</a>
