---
interface Props {
  icon: string;
  iconColorClass: string;
  hoverBgClass?: string;
  href?: string;
  label: string;
  value: string;
  rootClass?: string;
  valueClass?: string;
}

const {
  icon,
  iconColorClass,
  hoverBgClass = '',
  href,
  label,
  value,
  rootClass,
  valueClass = 'text-on-surface font-bold',
} = Astro.props;

const Tag = href ? 'a' : 'div';
const resolvedRootClass = rootClass || (href ? 'flex items-center gap-4 group/info' : 'flex items-center gap-4');
const iconClass = [
  'w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center shrink-0 transition-colors',
  iconColorClass,
  hoverBgClass,
].filter(Boolean).join(' ');
---

<Tag href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined} class={resolvedRootClass}>
  <div class={iconClass}>
    <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings:'FILL' 1">{icon}</span>
  </div>
  <div class={href ? 'min-w-0' : ''}>
    <p class="text-xs text-on-surface-variant font-medium uppercase tracking-wider">{label}</p>
    <p class={valueClass}>{value}</p>
  </div>
</Tag>
