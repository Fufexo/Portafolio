---
interface Props {
  icon: string;
  iconColorClass: string;
  hoverBgClass?: string;
  href?: string;
  labelText?: string;
  labelEs?: string;
  labelEn?: string;
  valueText?: string;
  valueEs?: string;
  valueEn?: string;
  rootClass?: string;
  valueClass?: string;
}

const {
  icon,
  iconColorClass,
  hoverBgClass = '',
  href,
  labelText,
  labelEs,
  labelEn,
  valueText,
  valueEs,
  valueEn,
  rootClass,
  valueClass = 'text-on-surface font-bold',
} = Astro.props;

const Tag = href ? 'a' : 'div';
const resolvedRootClass = rootClass || (href ? 'flex items-center gap-4 group/info' : 'flex items-center gap-4');
const iconClass = [
  'w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center shrink-0 transition-colors',
  iconColorClass,
  hoverBgClass,
].filter(Boolean).join(' ');
const showTranslatedLabel = Boolean(labelEs && labelEn);
const showTranslatedValue = Boolean(valueEs && valueEn);
---

<Tag href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined} class={resolvedRootClass}>
  <div class={iconClass}>
    <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">{icon}</span>
  </div>
  <div class={href ? 'min-w-0' : ''}>
    {showTranslatedLabel ? (
      <p class="text-xs text-on-surface-variant font-medium uppercase tracking-wider" data-i18n data-es={labelEs} data-en={labelEn}>
        {labelEs}
      </p>
    ) : (
      <p class="text-xs text-on-surface-variant font-medium uppercase tracking-wider">{labelText}</p>
    )}

    {showTranslatedValue ? (
      <p class={valueClass} data-i18n data-es={valueEs} data-en={valueEn}>
        {valueEs}
      </p>
    ) : (
      <p class={valueClass}>{valueText}</p>
    )}
  </div>
</Tag>
