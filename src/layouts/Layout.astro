---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLang, useTranslations, localizePath, stripLangPrefix } from '../i18n/ui';
import defaultShareImage from '../assets/og-default.png';

interface Props {
  title: string;
  description?: string;
  /** Imagen al compartir el enlace (redes, WhatsApp). Se recorta a 1200×630. */
  image?: ImageMetadata;
  type?: 'website' | 'article';
}

const lang = getLang(Astro.currentLocale);
const tr = useTranslations(lang);

const {
  title,
  description = tr('meta.default.description'),
  image = defaultShareImage,
  type = 'website',
} = Astro.props;

// La URL canónica, las alternativas por idioma y la imagen absoluta necesitan el dominio
// (`site` en astro.config, tomado de SITE_URL). Sin dominio se omiten en vez de generar URLs rotas.
const site = Astro.site;
const basePath = stripLangPrefix(Astro.url.pathname);
const absolute = (path: string) => (site ? new URL(path, site).href : undefined);
const canonicalUrl = absolute(localizePath(basePath, lang));
const alternates = [
  { hreflang: 'es', href: absolute(localizePath(basePath, 'es')) },
  { hreflang: 'en', href: absolute(localizePath(basePath, 'en')) },
  { hreflang: 'x-default', href: absolute(localizePath(basePath, 'es')) },
];
const ogLocale = lang === 'en' ? 'en_US' : 'es_PE';
const ogLocaleAlternate = lang === 'en' ? 'es_PE' : 'en_US';
const shareImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareImageUrl = site ? new URL(shareImage.src, site).href : undefined;

// Solo se descargan estos íconos de Material Symbols (orden alfabético obligatorio).
// Si usas un ícono nuevo, agrégalo aquí o se verá su nombre en texto.
const materialIcons = [
  'account_balance', 'admin_panel_settings', 'arrow_outward', 'auto_awesome', 'balance', 'bolt',
  'cached', 'chat', 'check_circle', 'cloud', 'code', 'contact_phone', 'credit_card',
  'currency_exchange', 'dark_mode', 'dashboard', 'database', 'download', 'eco', 'error',
  'expand_more', 'filter_list', 'format_list_numbered', 'grid_view', 'hourglass_empty', 'hub',
  'image_search', 'inventory_2', 'key', 'layers', 'lightbulb', 'location_on', 'lock', 'mail',
  'mark_email_read', 'person', 'replay', 'science', 'send', 'shopping_cart', 'speed', 'storage',
  'terminal', 'undo', 'verified_user', 'work',
].sort();
const materialIconsHref =
  'https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1' +
  `&icon_names=${materialIcons.join(',')}&display=block`;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {site && alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}

    <!-- Vista previa al compartir (Open Graph / Twitter) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Fabrizio Fournier" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    {shareImageUrl && <meta property="og:image:width" content="1200" />}
    {shareImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}

    <!-- Debe ser un valor literal: coincide con --color-background -->
    <meta name="theme-color" content="#131315" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link href={materialIconsHref} rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-background text-on-surface selection:bg-primary/30 min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:px-4 focus:py-3 focus:rounded-md focus:bg-primary focus:text-on-primary focus:font-bold"
    >{tr('a11y.skip')}</a>
    <slot />

    <script>
      import { initScrollReveal } from '../scripts/scroll-reveal';
      import { onPageLoad } from '../scripts/lifecycle';
      onPageLoad(initScrollReveal);
    </script>
  </body>
</html>
