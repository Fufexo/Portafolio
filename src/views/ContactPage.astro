---
/** Contacto (se renderiza en el idioma de la URL: /contact o /en/contact). */
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import SocialIconLink from '../components/SocialIconLink.astro';
import FormField from '../components/form/FormField.astro';
import ContactInfoItem from '../components/contact/ContactInfoItem.astro';
import RotatingHeadline from '../components/RotatingHeadline.astro';
import { getLang, useTranslations, t, headlineWords, type UiKey } from '../i18n/ui';

const tr = useTranslations(getLang(Astro.currentLocale));

const socialLinks = [
  { href: 'https://github.com/Fufexo', label: 'GitHub', icon: 'code' },
  { href: 'https://www.linkedin.com/in/fabrizio-fournier/', label: 'LinkedIn', icon: 'work' },
  { href: 'https://wa.me/51988998500', label: 'WhatsApp', icon: 'chat' },
];

// Opciones agrupadas del select "Tipo de proyecto" (el value es lo que llega por Formspree)
const projectTypeGroups: { labelKey: UiKey; options: string[] }[] = [
  { labelKey: 'contact.form.type.group.web', options: ['landing', 'corporate', 'ecommerce', 'webapp'] },
  { labelKey: 'contact.form.type.group.special', options: ['backend', 'redesign', 'uiux'] },
  { labelKey: 'contact.form.type.group.other', options: ['maintenance', 'consulting', 'other'] },
];

const inputClass =
  'w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface placeholder:text-outline focus:ring-2 focus:ring-primary transition-all outline-none border-0';
---

<Layout title={tr('meta.contact.title')} description={tr('meta.contact.description')}>
  <TopNav />

  <main id="main" tabindex="-1" class="min-h-screen pt-28 md:pt-36 pb-36 md:pb-24 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

      <!-- Izquierda: texto y datos de contacto -->
      <div class="lg:col-span-5 space-y-10">
        <span class="inline-block px-3 py-1 bg-secondary-container/20 text-secondary text-xs font-bold uppercase tracking-widest rounded-sm">
          {tr('contact.status')}
        </span>

        <RotatingHeadline
          lead={t('contact.headline.lead')}
          words={headlineWords.contact}
          class="text-4xl sm:text-5xl xl:text-6xl"
        />

        <p class="text-on-surface-variant text-base md:text-lg max-w-md leading-relaxed mt-4">
          {tr('contact.subtitle')}
        </p>

        <div class="space-y-5 pt-2">
          <ContactInfoItem
            href="mailto:fabriziofournier2003@hotmail.com"
            icon="mail"
            iconColorClass="text-primary"
            hoverBgClass="group-hover/info:bg-primary/20"
            label={tr('contact.email.label')}
            value="fabriziofournier2003@hotmail.com"
            rootClass="flex items-center gap-4 group/info min-w-0"
            valueClass="text-on-surface font-bold group-hover/info:text-primary transition-colors break-all"
          />
          <ContactInfoItem
            href="https://wa.me/51988998500"
            icon="contact_phone"
            iconColorClass="text-tertiary"
            hoverBgClass="group-hover/info:bg-tertiary/20"
            label="WhatsApp"
            value="+51 988 998 500"
            valueClass="text-on-surface font-bold group-hover/info:text-tertiary transition-colors"
          />
          <ContactInfoItem
            icon="location_on"
            iconColorClass="text-secondary"
            label={tr('contact.location.label')}
            value={tr('contact.location.value')}
          />
        </div>

        <div class="flex gap-3 pt-4">
          {socialLinks.map(({ href, label, icon }) => (
            <SocialIconLink href={href} label={label} icon={icon} />
          ))}
        </div>
      </div>

      <!-- Derecha: formulario + terminal -->
      <div class="lg:col-span-7 space-y-8">
        <div class="glass-effect rounded-xl ghost-border p-6 sm:p-8 md:p-14 shadow-elevated">

          <!-- Estado: enviado -->
          <div id="form-success" tabindex="-1" role="status" class="outline-none hidden flex-col items-center justify-center text-center py-16 gap-6">
            <span class="material-symbols-outlined text-primary text-6xl" aria-hidden="true" style="font-variation-settings:'FILL' 1">check_circle</span>
            <div>
              <p class="text-2xl font-black text-on-surface mb-2">{tr('contact.form.success.title')}</p>
              <p class="text-on-surface-variant text-sm">{tr('contact.form.success.sub')}</p>
            </div>
          </div>

          <!-- Estado: error -->
          <div id="form-error" tabindex="-1" role="alert" class="outline-none hidden flex-col items-center justify-center text-center py-8 gap-4">
            <span class="material-symbols-outlined text-error text-4xl" aria-hidden="true" style="font-variation-settings:'FILL' 1">error</span>
            <p
              id="error-msg"
              class="text-on-surface font-bold"
              data-msg-server={tr('contact.form.error')}
              data-msg-connection={tr('contact.form.error.connection')}
            >{tr('contact.form.error')}</p>
            <button type="button" id="error-retry" class="min-h-11 px-4 text-primary text-sm font-bold underline underline-offset-4">
              {tr('contact.form.retry')}
            </button>
          </div>

          <form id="contact-form" class="space-y-8" action="https://formspree.io/f/mnjooovq" method="POST">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <FormField id="name" label={tr('contact.form.name')}>
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  placeholder={tr('contact.form.name.placeholder')}
                  class={inputClass}
                />
              </FormField>
              <FormField id="email" label={tr('contact.form.email')}>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                  placeholder={tr('contact.form.email.placeholder')}
                  class={inputClass}
                />
              </FormField>
            </div>

            <FormField id="project-type" label={tr('contact.form.type')}>
              <div class="relative">
                <select
                  id="project-type"
                  name="project-type"
                  required
                  class="w-full bg-surface-container-lowest rounded-md pl-5 pr-12 py-4 text-on-surface invalid:text-outline focus:ring-2 focus:ring-primary transition-all outline-none border-0 appearance-none cursor-pointer"
                >
                  <option value="" disabled selected hidden>{tr('contact.form.type.placeholder')}</option>
                  {projectTypeGroups.map(({ labelKey, options }) => (
                    <optgroup label={tr(labelKey)} class="bg-surface-container text-on-surface-variant">
                      {options.map((value) => (
                        <option value={value} class="text-on-surface">{tr(`contact.form.type.${value}` as UiKey)}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none" aria-hidden="true">expand_more</span>
              </div>
            </FormField>

            <FormField id="message" label={tr('contact.form.message')}>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder={tr('contact.form.message.placeholder')}
                class={`${inputClass} resize-none`}
              ></textarea>
            </FormField>

            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
              <div class="flex items-center gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">verified_user</span>
                <span class="text-xs font-medium">{tr('contact.form.secure')}</span>
              </div>
              <button
                type="submit"
                data-sending-label={tr('contact.form.sending')}
                class="w-full sm:w-auto justify-center primary-gradient-glow text-on-primary px-8 min-h-12 rounded-md font-black tracking-tight text-base shadow-glow-cta transition-all hover:scale-[1.02] active:scale-95 disabled:cursor-wait disabled:opacity-70 flex items-center gap-2"
              >
                <span data-submit-label>{tr('contact.form.submit')}</span>
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">send</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Terminal decorativa -->
        <div class="rounded-xl ghost-border bg-surface-container-lowest overflow-hidden shadow-elevated" aria-hidden="true">
          <div class="flex items-center gap-2 px-4 py-3 bg-surface-container border-b border-outline-variant/20">
            <span class="w-3 h-3 rounded-full bg-window-close"></span>
            <span class="w-3 h-3 rounded-full bg-window-minimize"></span>
            <span class="w-3 h-3 rounded-full bg-window-maximize"></span>
            <span class="ml-auto text-[11px] text-on-surface-variant font-mono">fabrizio.js</span>
          </div>
          <div class="p-6 font-mono text-sm leading-7 select-none overflow-x-auto">
            <p>
              <span class="text-on-surface/55">const</span>
              <span class="text-secondary"> dev</span>
              <span class="text-on-surface/55"> = </span>
              <span class="text-on-surface/50">{'{'}</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">name</span><span class="text-on-surface/55">: </span>
              <span class="text-syntax-string">"Fabrizio Fournier"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">status</span><span class="text-on-surface/55">: </span>
              <span class="text-syntax-string">"{tr('contact.terminal.status')}"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">location</span><span class="text-on-surface/55">: </span>
              <span class="text-syntax-string">"{tr('contact.terminal.location')}"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">response</span><span class="text-on-surface/55">: </span>
              <span class="text-syntax-number">"&lt; 24h"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">open_to</span><span class="text-on-surface/55">: </span>
              <span class="text-syntax-number">"freelance &amp; full-time"</span>
            </p>
            <p><span class="text-on-surface/50">{'}'}</span></p>
            <p class="mt-2">
              <span class="text-on-surface/55">// </span>
              <span class="text-on-surface-variant italic">{tr('contact.terminal.comment')}</span>
              <span class="inline-block w-2 h-4 bg-primary ml-1 align-middle animate-[blink_1s_step-end_infinite]"></span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <BottomNav />
  <Footer />
</Layout>

<script>
  import { onPageLoad } from '../scripts/lifecycle';
  // Envío del formulario a Formspree sin recargar la página
  function initForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successEl = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');
    if (!form || !successEl || !errorEl || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const btn = form.querySelector<HTMLButtonElement>('[type="submit"]');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    const originalText = label?.textContent ?? '';

    const show = (el: HTMLElement) => {
      el.classList.remove('hidden');
      el.classList.add('flex');
    };
    const hide = (el: HTMLElement) => {
      el.classList.add('hidden');
      el.classList.remove('flex');
    };

    function setSending(sending: boolean) {
      if (!btn) return;
      btn.disabled = sending;
      if (label) label.textContent = sending ? (btn.dataset.sendingLabel ?? '…') : originalText;
    }

    function showError(isConnection: boolean) {
      const msg = document.getElementById('error-msg');
      if (msg) msg.textContent = (isConnection ? msg.dataset.msgConnection : msg.dataset.msgServer) ?? '';
      form!.classList.add('hidden');
      show(errorEl!);
      errorEl!.focus();
    }

    document.getElementById('error-retry')?.addEventListener('click', () => {
      hide(errorEl);
      form.classList.remove('hidden');
      form.querySelector<HTMLElement>('input, textarea')?.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setSending(true);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.classList.add('hidden');
          show(successEl);
          successEl.focus();
        } else {
          setSending(false);
          showError(false);
        }
      } catch {
        setSending(false);
        showError(true);
      }
    });
  }

  onPageLoad(initForm);
</script>
