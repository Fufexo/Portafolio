---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import SocialIconLink from '../components/SocialIconLink.astro';
import FormField from '../components/form/FormField.astro';
import ContactInfoItem from '../components/contact/ContactInfoItem.astro';
import RotatingHeadline from '../components/RotatingHeadline.astro';
import { ui, headlineWords } from '../i18n/ui';

const es = ui.es;
const en = ui.en;

const socialLinks = [
  { href: 'https://github.com/Fufexo', label: 'GitHub', icon: 'code' },
  { href: 'https://www.linkedin.com/in/fabrizio-fournier/', label: 'LinkedIn', icon: 'work' },
  { href: 'https://wa.me/51988998500', label: 'WhatsApp', icon: 'chat' },
];

// Opciones agrupadas del select "Tipo de proyecto" (el value es lo que llega por Formspree)
const projectTypeGroups = [
  {
    labelKey: 'contact.form.type.group.web',
    options: ['landing', 'corporate', 'ecommerce', 'webapp'],
  },
  {
    labelKey: 'contact.form.type.group.special',
    options: ['backend', 'redesign', 'uiux'],
  },
  {
    labelKey: 'contact.form.type.group.other',
    options: ['maintenance', 'consulting', 'other'],
  },
] as const;

const t = (key: string) => ({
  es: es[key as keyof typeof es],
  en: en[key as keyof typeof en],
});
---

<Layout
  title="Contacto | Fabrizio Fournier"
  description="Contacta a Fabrizio Fournier para tu próximo proyecto web: páginas, tiendas online, aplicaciones a medida y más."
>
  <TopNav />

  <main id="main" tabindex="-1" class="min-h-screen pt-28 md:pt-36 pb-36 md:pb-24 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

      <!-- Left: Editorial Content -->
      <div class="lg:col-span-5 space-y-10">

        <!-- Status badge -->
        <span
          class="inline-block px-3 py-1 bg-secondary-container/20 text-secondary text-xs font-bold uppercase tracking-widest rounded-sm"
          data-i18n data-es={es['contact.status']} data-en={en['contact.status']}
        >
          {es['contact.status']}
        </span>

        <!-- Headline -->
        <RotatingHeadline
          leadEs={es['contact.headline.lead']}
          leadEn={en['contact.headline.lead']}
          wordsEs={headlineWords.contact.es}
          wordsEn={headlineWords.contact.en}
          class="text-4xl sm:text-5xl xl:text-6xl"
        />

        <!-- Subtitle -->
        <p
          class="text-on-surface-variant text-base md:text-lg max-w-md leading-relaxed mt-4"
          data-i18n data-es={es['contact.subtitle']} data-en={en['contact.subtitle']}
        >
          {es['contact.subtitle']}
        </p>

        <!-- Contact info -->
        <div class="space-y-5 pt-2">
          <ContactInfoItem
            href="mailto:fabriziofournier2003@hotmail.com"
            icon="mail"
            iconColorClass="text-primary"
            hoverBgClass="group-hover/info:bg-primary/20"
            labelEs={es['contact.email.label']}
            labelEn={en['contact.email.label']}
            valueText="fabriziofournier2003@hotmail.com"
            rootClass="flex items-center gap-4 group/info min-w-0"
            valueClass="text-on-surface font-bold group-hover/info:text-primary transition-colors break-all"
          />

          <ContactInfoItem
            href="https://wa.me/51988998500"
            icon="contact_phone"
            iconColorClass="text-tertiary"
            hoverBgClass="group-hover/info:bg-tertiary/20"
            labelText="WhatsApp"
            valueText="+51 988 998 500"
            valueClass="text-on-surface font-bold group-hover/info:text-tertiary transition-colors"
          />

          <ContactInfoItem
            icon="location_on"
            iconColorClass="text-secondary"
            labelEs={es['contact.location.label']}
            labelEn={en['contact.location.label']}
            valueEs={es['contact.location.value']}
            valueEn={en['contact.location.value']}
          />
        </div>

        <!-- Social links -->
        <div class="flex gap-3 pt-4">
          {socialLinks.map(({ href, label, icon }) => (
            <SocialIconLink href={href} label={label} icon={icon} />
          ))}
        </div>

      </div>

      <!-- Right: Form + Image -->
      <div class="lg:col-span-7 space-y-8">

        <!-- Glass form -->
        <div class="glass-effect rounded-xl ghost-border p-6 sm:p-8 md:p-14 shadow-elevated">

          <!-- Success state -->
          <div id="form-success" tabindex="-1" role="status" class="outline-none hidden flex-col items-center justify-center text-center py-16 gap-6">
            <span class="material-symbols-outlined text-primary text-6xl" style="font-variation-settings:'FILL' 1">check_circle</span>
            <div>
              <p
                class="text-2xl font-black text-on-surface mb-2"
                data-i18n
                data-es={es['contact.form.success.title']}
                data-en={en['contact.form.success.title']}
              >{es['contact.form.success.title']}</p>
              <p
                class="text-on-surface-variant text-sm"
                data-i18n
                data-es={es['contact.form.success.sub']}
                data-en={en['contact.form.success.sub']}
              >{es['contact.form.success.sub']}</p>
            </div>
          </div>

          <!-- Error state -->
          <div id="form-error" tabindex="-1" role="alert" class="outline-none hidden flex-col items-center justify-center text-center py-8 gap-4">
            <span class="material-symbols-outlined text-error text-4xl" style="font-variation-settings:'FILL' 1">error</span>
            <p
              class="text-on-surface font-bold"
              id="error-msg"
              data-es={es['contact.form.error']}
              data-en={en['contact.form.error']}
              data-connection-es={es['contact.form.error.connection']}
              data-connection-en={en['contact.form.error.connection']}
            >{es['contact.form.error']}</p>
            <button
              type="button"
              id="error-retry"
              class="min-h-11 px-4 text-primary text-sm font-bold underline underline-offset-4"
              data-i18n
              data-es="Intentar de nuevo"
              data-en="Try again"
            >Intentar de nuevo</button>
          </div>

          <form class="space-y-8" id="contact-form"
            action="https://formspree.io/f/mnjooovq"
            method="POST"
          >

            <!-- Name + Email row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <FormField
                id="name"
                labelEs={es['contact.form.name']}
                labelEn={en['contact.form.name']}
              >
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  class="w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface placeholder:text-outline focus:ring-2 focus:ring-primary transition-all outline-none border-0"
                  data-placeholder-es={es['contact.form.name.placeholder']}
                  data-placeholder-en={en['contact.form.name.placeholder']}
                  placeholder={es['contact.form.name.placeholder']}
                />
              </FormField>
              <FormField
                id="email"
                labelEs={es['contact.form.email']}
                labelEn={en['contact.form.email']}
              >
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                  class="w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface placeholder:text-outline focus:ring-2 focus:ring-primary transition-all outline-none border-0"
                  data-placeholder-es={es['contact.form.email.placeholder']}
                  data-placeholder-en={en['contact.form.email.placeholder']}
                  placeholder={es['contact.form.email.placeholder']}
                />
              </FormField>
            </div>

            <!-- Project type -->
            <FormField
              id="project-type"
              labelEs={es['contact.form.type']}
              labelEn={en['contact.form.type']}
            >
              <div class="relative">
                <select
                  id="project-type"
                  name="project-type"
                  required
                  class="w-full bg-surface-container-lowest rounded-md pl-5 pr-12 py-4 text-on-surface invalid:text-outline focus:ring-2 focus:ring-primary transition-all outline-none border-0 appearance-none cursor-pointer"
                >
                  <option
                    value=""
                    disabled
                    selected
                    hidden
                    data-i18n
                    data-es={es['contact.form.type.placeholder']}
                    data-en={en['contact.form.type.placeholder']}
                  >{es['contact.form.type.placeholder']}</option>
                  {projectTypeGroups.map(({ labelKey, options }) => (
                    <optgroup
                      label={t(labelKey).es}
                      data-label-es={t(labelKey).es}
                      data-label-en={t(labelKey).en}
                      class="bg-surface-container text-on-surface-variant"
                    >
                      {options.map((value) => {
                        const label = t(`contact.form.type.${value}`);
                        return (
                          <option value={value} class="text-on-surface" data-i18n data-es={label.es} data-en={label.en}>{label.es}</option>
                        );
                      })}
                    </optgroup>
                  ))}
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none" aria-hidden="true">expand_more</span>
              </div>
            </FormField>

            <!-- Message -->
            <FormField
              id="message"
              labelEs={es['contact.form.message']}
              labelEn={en['contact.form.message']}
            >
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface placeholder:text-outline focus:ring-2 focus:ring-primary transition-all outline-none border-0 resize-none"
                data-placeholder-es={es['contact.form.message.placeholder']}
                data-placeholder-en={en['contact.form.message.placeholder']}
                placeholder={es['contact.form.message.placeholder']}
              ></textarea>
            </FormField>

            <!-- Footer row -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
              <div class="flex items-center gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">verified_user</span>
                <span
                  class="text-xs font-medium"
                  data-i18n data-es={es['contact.form.secure']} data-en={en['contact.form.secure']}
                >
                  {es['contact.form.secure']}
                </span>
              </div>
              <button
                type="submit"
                class="w-full sm:w-auto justify-center primary-gradient-glow text-on-primary px-8 min-h-12 rounded-md font-black tracking-tight text-base shadow-glow-cta transition-all hover:scale-[1.02] active:scale-95 disabled:cursor-wait flex items-center gap-2"
              >
                <span data-i18n data-es={es['contact.form.submit']} data-en={en['contact.form.submit']}>{es['contact.form.submit']}</span>
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">send</span>
              </button>
            </div>

          </form>
        </div>

        <!-- Terminal -->
        <div class="rounded-xl ghost-border bg-surface-container-lowest overflow-hidden shadow-elevated">
          <!-- Chrome bar -->
          <div class="flex items-center gap-2 px-4 py-3 bg-surface-container border-b border-outline-variant/20">
            <span class="w-3 h-3 rounded-full bg-window-close"></span>
            <span class="w-3 h-3 rounded-full bg-window-minimize"></span>
            <span class="w-3 h-3 rounded-full bg-window-maximize"></span>
            <span class="ml-auto text-[11px] text-on-surface-variant font-mono">fabrizio.js</span>
          </div>
          <!-- Terminal body -->
          <div class="p-6 font-mono text-sm leading-7 select-none overflow-x-auto" aria-hidden="true">
            <p>
              <span class="text-on-surface/55">const</span>
              <span class="text-secondary"> dev</span>
              <span class="text-on-surface/55"> = </span>
              <span class="text-on-surface/50">{`{`}</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">name</span>
              <span class="text-on-surface/55">: </span>
              <span class="text-syntax-string">"Fabrizio Fournier"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">status</span>
              <span class="text-on-surface/55">: </span>
              <span class="text-syntax-string" id="term-status">"disponible"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">location</span>
              <span class="text-on-surface/55">: </span>
              <span class="text-syntax-string">"Lima, Perú 🇵🇪"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">response</span>
              <span class="text-on-surface/55">: </span>
              <span class="text-syntax-number" id="term-response">"&lt; 24h"</span><span class="text-on-surface/55">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">open_to</span>
              <span class="text-on-surface/55">: </span>
              <span class="text-syntax-number" id="term-open">"freelance &amp; full-time"</span>
            </p>
            <p>
              <span class="text-on-surface/50">{`}`}</span>
            </p>
            <p class="mt-2">
              <span class="text-on-surface/55">// </span>
              <span class="text-on-surface-variant italic" id="term-comment">listo para tu próximo proyecto</span>
              <span class="inline-block w-2 h-4 bg-primary ml-1 align-middle animate-[blink_1s_step-end_infinite]"></span>
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <BottomNav />
  <Footer />

  <script is:inline>
    (function () {
      // Sync placeholders with language
      function syncPlaceholders(lang) {
        document.querySelectorAll('[data-placeholder-es]').forEach(function (el) {
          var val = el.getAttribute('data-placeholder-' + lang);
          if (val) el.placeholder = val;
        });
        document.querySelectorAll('optgroup[data-label-es]').forEach(function (el) {
          var val = el.getAttribute('data-label-' + lang);
          if (val) el.label = val;
        });
      }

      // Formspree AJAX submit
      function initForm() {
        var form = document.getElementById('contact-form');
        var successEl = document.getElementById('form-success');
        var errorEl = document.getElementById('form-error');
        var retryBtn = document.getElementById('error-retry');
        if (!form || !successEl || !errorEl) return;
        if (form.dataset.bound === '1') return;
        form.dataset.bound = '1';

        function showError(isConnection) {
          var lang = localStorage.getItem('fabrizio-lang') || 'es';
          var msgEl = document.getElementById('error-msg');
          if (msgEl) {
            var attr = isConnection ? 'data-connection-' + lang : 'data-' + lang;
            msgEl.textContent = msgEl.getAttribute(attr) || msgEl.getAttribute('data-es') || '';
          }
          form.classList.add('hidden');
          errorEl.classList.remove('hidden');
          errorEl.classList.add('flex');
          errorEl.focus();
        }

        if (retryBtn) {
          retryBtn.addEventListener('click', function () {
            errorEl.classList.add('hidden');
            errorEl.classList.remove('flex');
            form.classList.remove('hidden');
            var firstField = form.querySelector('input, textarea');
            if (firstField) firstField.focus();
          });
        }

        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          var btn = form.querySelector('[type="submit"]');
          if (!btn) return;
          var btnText = btn.querySelector('span[data-i18n]');
          var originalText = btnText ? btnText.textContent : btn.textContent;

          btn.disabled = true;
          btn.classList.add('opacity-70');
          if (btnText) btnText.textContent = '...';

          try {
            var res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });

            if (res.ok) {
              form.classList.add('hidden');
              successEl.classList.remove('hidden');
              successEl.classList.add('flex');
              successEl.focus();
            } else {
              btn.disabled = false;
              btn.classList.remove('opacity-70');
              if (btnText) btnText.textContent = originalText;
              showError(false);
            }
          } catch {
            btn.disabled = false;
            btn.classList.remove('opacity-70');
            if (btnText) btnText.textContent = originalText;
            showError(true);
          }
        });
      }

      function init() {
        var lang = localStorage.getItem('fabrizio-lang') || 'es';
        syncPlaceholders(lang);
        syncTerminal(lang);
        initForm();
      }

      document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('astro:page-load', init);
      document.addEventListener('fabrizio:langchange', function (e) {
        syncPlaceholders(e.detail.lang);
        syncTerminal(e.detail.lang);
      });

      // Sync terminal text with language
      function syncTerminal(lang) {
        var terminalTexts = {
          es: {
            'term-status': '"disponible"',
            'term-response': '"< 24h"',
            'term-open': '"freelance & full-time"',
            'term-comment': 'listo para tu próximo proyecto',
          },
          en: {
            'term-status': '"available"',
            'term-response': '"< 24h"',
            'term-open': '"freelance & full-time"',
            'term-comment': 'ready for your next project',
          },
        };
        var locale = terminalTexts[lang] ? lang : 'es';

        Object.keys(terminalTexts[locale]).forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          el.textContent = terminalTexts[locale][id];
        });
      }
    })();
  </script>
</Layout>
