---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import { ui, gradientStyle } from '../i18n/ui';

const es = ui.es;
const en = ui.en;
---

<Layout title="Contacto | Fabrizio">
  <TopNav />

  <main class="min-h-screen pt-32 pb-24 px-6 md:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

      <!-- Left: Editorial Content -->
      <div class="lg:col-span-5 space-y-10">

        <!-- Status badge -->
        <span
          class="inline-block px-3 py-1 bg-secondary-container/20 text-secondary text-xs font-bold uppercase tracking-widest rounded-sm"
          data-i18n data-es={es['contact.status']} data-en={en['contact.status']}
        >
          {es['contact.status']}
        </span>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tighter leading-[0.9]">
          <span class="hero-word" style={gradientStyle} data-i18n data-es={es['contact.title']} data-en={en['contact.title']}>{es['contact.title']}</span>
          <br />
          <span class="hero-accent" style={gradientStyle} data-i18n data-es={es['contact.title.accent']} data-en={en['contact.title.accent']}>{es['contact.title.accent']}</span>
        </h1>

        <!-- Subtitle -->
        <p
          class="text-on-surface-variant text-base md:text-lg max-w-md leading-relaxed mt-4"
          data-i18n data-es={es['contact.subtitle']} data-en={en['contact.subtitle']}
        >
          {es['contact.subtitle']}
        </p>

        <!-- Contact info -->
        <div class="space-y-5 pt-2">
          <a href="mailto:fabriziofournier2003@hotmail.com" class="flex items-center gap-4 group/info min-w-0">
            <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary flex-shrink-0 group-hover/info:bg-primary/20 transition-colors">
              <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">mail</span>
            </div>
            <div class="min-w-0">
              <p
                class="text-xs text-on-surface-variant font-medium uppercase tracking-wider"
                data-i18n data-es={es['contact.email.label']} data-en={en['contact.email.label']}
              >
                {es['contact.email.label']}
              </p>
              <p class="text-on-surface font-bold group-hover/info:text-primary transition-colors break-all">fabriziofournier2003@hotmail.com</p>
            </div>
          </a>

          <a href="https://wa.me/51988998500" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 group/info">
            <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-tertiary flex-shrink-0 group-hover/info:bg-tertiary/20 transition-colors">
              <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">contact_phone</span>
            </div>
            <div>
              <p class="text-xs text-on-surface-variant font-medium uppercase tracking-wider">WhatsApp</p>
              <p class="text-on-surface font-bold group-hover/info:text-tertiary transition-colors">+51 988 998 500</p>
            </div>
          </a>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-secondary flex-shrink-0">
              <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">location_on</span>
            </div>
            <div>
              <p
                class="text-xs text-on-surface-variant font-medium uppercase tracking-wider"
                data-i18n data-es={es['contact.location.label']} data-en={en['contact.location.label']}
              >
                {es['contact.location.label']}
              </p>
              <p
                class="text-on-surface font-bold"
                data-i18n data-es={es['contact.location.value']} data-en={en['contact.location.value']}
              >
                {es['contact.location.value']}
              </p>
            </div>
          </div>
        </div>

        <!-- Social links -->
        <div class="flex gap-3 pt-4">
          <a
            href="https://github.com/Fufexo"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="social-icon w-11 h-11 flex items-center justify-center rounded-full bg-surface-container text-on-surface-variant ghost-border"
          >
            <span class="material-symbols-outlined text-[20px]">code</span>
          </a>
          <a
            href="https://www.linkedin.com/in/fabrizio-fournier/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="social-icon w-11 h-11 flex items-center justify-center rounded-full bg-surface-container text-on-surface-variant ghost-border"
          >
            <span class="material-symbols-outlined text-[20px]">work</span>
          </a>
          <a
            href="https://wa.me/51988998500"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="social-icon w-11 h-11 flex items-center justify-center rounded-full bg-surface-container text-on-surface-variant ghost-border"
          >
            <span class="material-symbols-outlined text-[20px]">chat</span>
          </a>
        </div>

      </div>

      <!-- Right: Form + Image -->
      <div class="lg:col-span-7 space-y-8">

        <!-- Glass form -->
        <div class="glass-effect rounded-xl ghost-border p-8 md:p-14 shadow-[0_20px_40px_rgba(0,0,0,0.4)]">

          <!-- Success state -->
          <div id="form-success" class="hidden flex-col items-center justify-center text-center py-16 gap-6">
            <span class="material-symbols-outlined text-primary text-6xl" style="font-variation-settings:'FILL' 1">check_circle</span>
            <div>
              <p
                class="text-2xl font-black text-on-surface mb-2"
                data-i18n
                data-es={es['contact.form.success.title']}
                data-en={en['contact.form.success.title']}
              >{es['contact.form.success.title']}</p>
              <p
                class="text-on-surface-variant text-sm"
                data-i18n
                data-es={es['contact.form.success.sub']}
                data-en={en['contact.form.success.sub']}
              >{es['contact.form.success.sub']}</p>
            </div>
          </div>

          <!-- Error state -->
          <div id="form-error" class="hidden flex-col items-center justify-center text-center py-8 gap-4">
            <span class="material-symbols-outlined text-error text-4xl" style="font-variation-settings:'FILL' 1">error</span>
            <p
              class="text-on-surface font-bold"
              id="error-msg"
              data-es={es['contact.form.error']}
              data-en={en['contact.form.error']}
              data-connection-es={es['contact.form.error.connection']}
              data-connection-en={en['contact.form.error.connection']}
            >{es['contact.form.error']}</p>
            <button
              type="button"
              id="error-retry"
              class="text-primary text-sm font-bold underline underline-offset-4"
              data-i18n
              data-es="Intentar de nuevo"
              data-en="Try again"
            >Intentar de nuevo</button>
          </div>

          <form class="space-y-10" id="contact-form"
            action="https://formspree.io/f/mnjooovq"
            method="POST"
          >

            <!-- Name + Email row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="flex flex-col gap-3 group">
                <label
                  class="text-xs font-bold uppercase tracking-wider text-on-surface-variant group-focus-within:text-primary transition-colors"
                  for="name"
                  data-i18n data-es={es['contact.form.name']} data-en={en['contact.form.name']}
                >
                  {es['contact.form.name']}
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  class="w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface placeholder:text-outline-variant focus:ring-2 focus:ring-primary transition-all outline-none border-0"
                  data-placeholder-es={es['contact.form.name.placeholder']}
                  data-placeholder-en={en['contact.form.name.placeholder']}
                  placeholder={es['contact.form.name.placeholder']}
                />
              </div>
              <div class="flex flex-col gap-3 group">
                <label
                  class="text-xs font-bold uppercase tracking-wider text-on-surface-variant group-focus-within:text-primary transition-colors"
                  for="email"
                  data-i18n data-es={es['contact.form.email']} data-en={en['contact.form.email']}
                >
                  {es['contact.form.email']}
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface placeholder:text-outline-variant focus:ring-2 focus:ring-primary transition-all outline-none border-0"
                  data-placeholder-es={es['contact.form.email.placeholder']}
                  data-placeholder-en={en['contact.form.email.placeholder']}
                  placeholder={es['contact.form.email.placeholder']}
                />
              </div>
            </div>

            <!-- Project type -->
            <div class="flex flex-col gap-3 group">
              <label
                class="text-xs font-bold uppercase tracking-wider text-on-surface-variant group-focus-within:text-primary transition-colors"
                for="project-type"
                data-i18n data-es={es['contact.form.type']} data-en={en['contact.form.type']}
              >
                {es['contact.form.type']}
              </label>
              <div class="relative">
                <select
                  id="project-type"
                  name="project-type"
                  class="w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface focus:ring-2 focus:ring-primary transition-all outline-none border-0 appearance-none cursor-pointer"
                >
                  <option value="ui" data-i18n data-es={es['contact.form.type.1']} data-en={en['contact.form.type.1']}>{es['contact.form.type.1']}</option>
                  <option value="fullstack" data-i18n data-es={es['contact.form.type.2']} data-en={en['contact.form.type.2']}>{es['contact.form.type.2']}</option>
                  <option value="strategy" data-i18n data-es={es['contact.form.type.3']} data-en={en['contact.form.type.3']}>{es['contact.form.type.3']}</option>
                  <option value="other" data-i18n data-es={es['contact.form.type.4']} data-en={en['contact.form.type.4']}>{es['contact.form.type.4']}</option>
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">expand_more</span>
              </div>
            </div>

            <!-- Message -->
            <div class="flex flex-col gap-3 group">
              <label
                class="text-xs font-bold uppercase tracking-wider text-on-surface-variant group-focus-within:text-primary transition-colors"
                for="message"
                data-i18n data-es={es['contact.form.message']} data-en={en['contact.form.message']}
              >
                {es['contact.form.message']}
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full bg-surface-container-lowest rounded-md px-5 py-4 text-on-surface placeholder:text-outline-variant focus:ring-2 focus:ring-primary transition-all outline-none border-0 resize-none"
                data-placeholder-es={es['contact.form.message.placeholder']}
                data-placeholder-en={en['contact.form.message.placeholder']}
                placeholder={es['contact.form.message.placeholder']}
              ></textarea>
            </div>

            <!-- Footer row -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
              <div class="flex items-center gap-2 text-on-surface-variant/40">
                <span class="material-symbols-outlined text-[18px]">verified_user</span>
                <span
                  class="text-xs font-medium"
                  data-i18n data-es={es['contact.form.secure']} data-en={en['contact.form.secure']}
                >
                  {es['contact.form.secure']}
                </span>
              </div>
              <button
                type="submit"
                class="primary-gradient-glow text-on-primary px-8 py-3.5 rounded-md font-black tracking-tight text-base shadow-[0_10px_20px_rgba(210,187,255,0.2)] transition-all hover:scale-[1.02] active:scale-95 flex items-center gap-2"
              >
                <span data-i18n data-es={es['contact.form.submit']} data-en={en['contact.form.submit']}>{es['contact.form.submit']}</span>
                <span class="material-symbols-outlined text-[20px]">send</span>
              </button>
            </div>

          </form>
        </div>

        <!-- Terminal -->
        <div class="rounded-xl ghost-border bg-surface-container-lowest overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.4)]">
          <!-- Chrome bar -->
          <div class="flex items-center gap-2 px-4 py-3 bg-surface-container border-b border-outline-variant/20">
            <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
            <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
            <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-auto text-[11px] text-on-surface-variant/40 font-mono">fabrizio.js</span>
          </div>
          <!-- Terminal body -->
          <div class="p-6 font-mono text-sm leading-7 select-none">
            <p>
              <span class="text-on-surface/30">const</span>
              <span class="text-secondary"> dev</span>
              <span class="text-on-surface/30"> = </span>
              <span class="text-on-surface/50">{`{`}</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">name</span>
              <span class="text-on-surface/30">: </span>
              <span class="text-[#98c379]">"Fabrizio Fournier"</span><span class="text-on-surface/30">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">status</span>
              <span class="text-on-surface/30">: </span>
              <span class="text-[#98c379]" id="term-status">"disponible"</span><span class="text-on-surface/30">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">location</span>
              <span class="text-on-surface/30">: </span>
              <span class="text-[#98c379]">"Lima, Perú 🇵🇪"</span><span class="text-on-surface/30">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">response</span>
              <span class="text-on-surface/30">: </span>
              <span class="text-[#e5c07b]" id="term-response">"&lt; 24h"</span><span class="text-on-surface/30">,</span>
            </p>
            <p class="pl-6">
              <span class="text-primary/70">open_to</span>
              <span class="text-on-surface/30">: </span>
              <span class="text-[#e5c07b]" id="term-open">"freelance &amp; full-time"</span>
            </p>
            <p>
              <span class="text-on-surface/50">{`}`}</span>
            </p>
            <p class="mt-2">
              <span class="text-on-surface/30">// </span>
              <span class="text-on-surface/40 italic" id="term-comment">listo para tu próximo proyecto</span>
              <span class="inline-block w-2 h-4 bg-primary ml-1 align-middle animate-[blink_1s_step-end_infinite]"></span>
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <BottomNav />
  <Footer />

  <script is:inline>
    (function () {
      // Sync placeholders with language
      function syncPlaceholders(lang) {
        document.querySelectorAll('[data-placeholder-es]').forEach(function (el) {
          var val = el.getAttribute('data-placeholder-' + lang);
          if (val) el.placeholder = val;
        });
      }

      // Formspree AJAX submit
      function initForm() {
        var form = document.getElementById('contact-form');
        var successEl = document.getElementById('form-success');
        var errorEl = document.getElementById('form-error');
        var retryBtn = document.getElementById('error-retry');
        if (!form || !successEl || !errorEl) return;

        function showError(isConnection) {
          var lang = localStorage.getItem('fabrizio-lang') || 'es';
          var msgEl = document.getElementById('error-msg');
          if (msgEl) {
            var attr = isConnection ? 'data-connection-' + lang : 'data-' + lang;
            msgEl.textContent = msgEl.getAttribute(attr) || msgEl.getAttribute('data-es') || '';
          }
          form.classList.add('hidden');
          errorEl.classList.remove('hidden');
          errorEl.classList.add('flex');
        }

        if (retryBtn) {
          retryBtn.addEventListener('click', function () {
            errorEl.classList.add('hidden');
            errorEl.classList.remove('flex');
            form.classList.remove('hidden');
          });
        }

        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          var btn = form.querySelector('[type="submit"]');
          if (!btn) return;
          var btnText = btn.querySelector('span[data-i18n]');
          var originalText = btnText ? btnText.textContent : btn.textContent;

          btn.disabled = true;
          btn.classList.add('opacity-70');
          if (btnText) btnText.textContent = '...';

          try {
            var res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });

            if (res.ok) {
              form.classList.add('hidden');
              successEl.classList.remove('hidden');
              successEl.classList.add('flex');
            } else {
              btn.disabled = false;
              btn.classList.remove('opacity-70');
              if (btnText) btnText.textContent = originalText;
              showError(false);
            }
          } catch {
            btn.disabled = false;
            btn.classList.remove('opacity-70');
            if (btnText) btnText.textContent = originalText;
            showError(true);
          }
        });
      }

      function init() {
        var lang = localStorage.getItem('fabrizio-lang') || 'es';
        syncPlaceholders(lang);
        initForm();
      }

      document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('astro:page-load', init);
      document.addEventListener('fabrizio:langchange', function (e) {
        syncPlaceholders(e.detail.lang);
        syncTerminal(e.detail.lang);
      });

      // Sync terminal text with language
      function syncTerminal(lang) {
        var status  = document.getElementById('term-status');
        var resp    = document.getElementById('term-response');
        var open    = document.getElementById('term-open');
        var comment = document.getElementById('term-comment');
        if (!status) return;
        if (lang === 'en') {
          status.textContent  = '"available"';
          resp.textContent    = '"< 24h"';
          open.textContent    = '"freelance & full-time"';
          comment.textContent = 'ready for your next project';
        } else {
          status.textContent  = '"disponible"';
          resp.textContent    = '"< 24h"';
          open.textContent    = '"freelance & full-time"';
          comment.textContent = 'listo para tu próximo proyecto';
        }
      }
    })();
  </script>
</Layout>
