---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import ComingSoonCard from '../components/ComingSoonCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RotatingHeadline from '../components/RotatingHeadline.astro';
import { getCollection } from 'astro:content';
import { ui, headlineWords } from '../i18n/ui';

const es = ui.es;
const en = ui.en;

const filters = [
  { value: 'all',       es: es['home.filter.all'],       en: en['home.filter.all'] },
  { value: 'ecommerce', es: es['home.filter.ecommerce'], en: en['home.filter.ecommerce'] },
  { value: 'saas',      es: es['home.filter.saas'],      en: en['home.filter.saas'] },
  { value: 'ai',        es: es['home.filter.ai'],        en: en['home.filter.ai'] },
  { value: 'fintech',   es: es['home.filter.fintech'],   en: en['home.filter.fintech'] },
];

// Proyectos desde la colección (src/content/projects), ordenados por `order`
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Espacios "Próximo proyecto" en desktop: completan la cuadrícula hasta 5 elementos
const placeholderCount = Math.max(0, 5 - projects.length);
---

<Layout
  title="Fabrizio Fournier — Desarrollador Full Stack"
  description="Proyectos de Fabrizio Fournier, desarrollador full stack: e-commerce con pagos reales, apps con IA y productos web de punta a punta."
>
  <TopNav />

  <main id="main" tabindex="-1" class="pt-28 md:pt-36 pb-36 md:pb-24 px-4 sm:px-8 max-w-7xl mx-auto">

    <!-- Header -->
    <section class="mb-8 md:mb-16">
      <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-6 xl:gap-8">
        <div class="max-w-2xl">
          <p
            class="text-secondary font-semibold text-xs sm:text-sm tracking-[0.2em] uppercase mb-4 md:mb-6"
            data-i18n
            data-es={es['home.eyebrow']}
            data-en={en['home.eyebrow']}
          >
            {es['home.eyebrow']}
          </p>
          <RotatingHeadline
            leadEs={es['home.headline.lead']}
            leadEn={en['home.headline.lead']}
            wordsEs={headlineWords.home.es}
            wordsEn={headlineWords.home.en}
            class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl"
          />
          <p
            class="text-on-surface-variant text-base mt-4 md:mt-6 leading-relaxed"
            data-i18n
            data-es={es['home.subtitle']}
            data-en={en['home.subtitle']}
          >
            {es['home.subtitle']}
          </p>
        </div>

        <!-- Filtros: pills con scroll horizontal en móvil, texto en desktop -->
        <div
          id="project-filters"
          role="group"
          aria-label={es['home.filter.label']}
          data-aria-es={es['home.filter.label']}
          data-aria-en={en['home.filter.label']}
          class="flex gap-2 xl:gap-1 overflow-x-auto no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0 xl:justify-end xl:shrink-0"
        >
          {filters.map(({ value, es: labelEs, en: labelEn }, i) => (
            <button
              type="button"
              data-filter={value}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-i18n
              data-es={labelEs}
              data-en={labelEn}
              class="shrink-0 min-h-11 px-4 rounded-full text-sm font-bold whitespace-nowrap transition-colors duration-200
                     bg-surface-container-low text-on-surface-variant hover:text-primary
                     aria-pressed:bg-primary-container aria-pressed:text-on-primary-container
                     xl:bg-transparent xl:aria-pressed:bg-surface-container-high xl:aria-pressed:text-primary"
            >
              {labelEs}
            </button>
          ))}
        </div>
      </div>
    </section>

    <p
      id="filter-empty"
      hidden
      role="status"
      class="rounded-xl ghost-border bg-surface-container-low px-6 py-12 text-center text-on-surface-variant mb-6"
      data-i18n
      data-es={es['home.filter.empty']}
      data-en={en['home.filter.empty']}
    >
      {es['home.filter.empty']}
    </p>

    <!-- Mobile: cards verticales -->
    <div class="flex md:hidden flex-col gap-6">
      {projects.map((project, i) => (
        <ProjectCard project={project} variant="mobile" eager={i === 0} />
      ))}
      <div data-coming-soon>
        <ComingSoonCard
          articleClass="relative bg-surface-container-low rounded-xl overflow-hidden min-h-30"
          textEs={es['home.coming-soon']}
          textEn={en['home.coming-soon']}
        />
      </div>
    </div>

    <!-- Desktop: Bento Grid -->
    <div class="hidden md:grid grid-cols-12 gap-6 lg:gap-8">
      {projects.map((project, i) => (
        <ProjectCard project={project} variant="desktop" eager={i === 0} />
      ))}
      {Array.from({ length: placeholderCount }).map(() => (
        <div data-coming-soon class="md:col-span-4">
          <ComingSoonCard
            articleClass="h-full relative overflow-hidden rounded-xl bg-surface-container-low"
            contentClass="p-10 h-full flex flex-col items-center justify-center gap-4 text-center"
            iconSize="lg"
            textEs={es['home.coming-soon']}
            textEn={en['home.coming-soon']}
          />
        </div>
      ))}
    </div>
  </main>

  <BottomNav />
  <Footer />

  <script is:inline>
    (function () {
      function initFilters() {
        var group = document.getElementById('project-filters');
        if (!group || group.dataset.bound === '1') return;
        group.dataset.bound = '1';

        group.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-filter]');
          if (!btn) return;
          var value = btn.getAttribute('data-filter');

          group.querySelectorAll('[data-filter]').forEach(function (b) {
            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          });

          var visible = 0;
          document.querySelectorAll('[data-project-card]').forEach(function (card) {
            var show = value === 'all' || card.getAttribute('data-category') === value;
            card.hidden = !show;
            // Contamos solo una de las dos variantes (mobile/desktop) visibles en pantalla
            if (show && card.offsetParent !== null) visible++;
          });

          document.querySelectorAll('[data-coming-soon]').forEach(function (el) {
            el.hidden = value !== 'all';
          });

          var empty = document.getElementById('filter-empty');
          if (empty) empty.hidden = visible > 0;
        });
      }

      document.addEventListener('DOMContentLoaded', initFilters);
      document.addEventListener('astro:page-load', initFilters);
    })();
  </script>
</Layout>
