---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import TechTag from '../components/TechTag.astro';
import RotatingHeadline from '../components/RotatingHeadline.astro';
import { ui, headlineWords } from '../i18n/ui';
import { frontendTags, backendTags, databaseTags, cloudTags } from '../data/stack';
import { timeline } from '../data/timeline';

const es = ui.es;
const en = ui.en;
---

<Layout
  title="Sobre mí | Fabrizio Fournier"
  description="Fabrizio Fournier, desarrollador full stack especializado en Angular, con experiencia construyendo productos en el sector financiero."
>
  <TopNav />

  <main id="main" tabindex="-1" class="pt-28 md:pt-36 pb-36 md:pb-24 px-4 md:px-12 max-w-7xl mx-auto overflow-x-clip">
    <div class="flex flex-col gap-20 md:gap-40">

    <!-- Hero Narrativo -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8">
        <span
          class="text-secondary font-medium text-sm tracking-[0.3em] uppercase mb-6 block"
          data-i18n data-es={es['about.label']} data-en={en['about.label']}
        >
          {es['about.label']}
        </span>

        <RotatingHeadline
          leadEs={es['about.headline.lead']}
          leadEn={en['about.headline.lead']}
          wordsEs={headlineWords.about.es}
          wordsEn={headlineWords.about.en}
          class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl mb-8"
        />

        <p
          class="text-lg md:text-xl text-on-surface-variant max-w-2xl leading-relaxed"
          data-i18n data-es={es['about.bio']} data-en={en['about.bio']}
        >
          {es['about.bio']}
        </p>

        <a
          href="/resume.pdf"
          download
          class="inline-flex items-center gap-2 mt-8 px-6 min-h-12 rounded-md ghost-border text-on-surface hover:text-primary transition-all duration-200 text-sm font-bold tracking-wide group"
        >
          <span class="material-symbols-outlined text-[18px] group-hover:translate-y-0.5 transition-transform duration-200" aria-hidden="true">download</span>
          <span data-i18n data-es={es['resume.download']} data-en={en['resume.download']}>{es['resume.download']}</span>
        </a>
      </div>

      <div class="lg:col-span-4 aspect-square rounded-xl overflow-hidden ghost-border relative group">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBYZSbk0soO7t2ViAUhSbZqu60thY1kU8qxQFXqLXODSISrphtUQFoxekZNyAGzv95qNfmGVewhvaqFhWdjISz4DL4cbrBVgrBxNXVVAWj6lsYpVypBlFQgH8UBQJEu2lJpsI-8zUe2axFLpU8TnNEayxI649aFAf05Q-hcuwmDGs2_pN40SSh_Uq8SCUikqKJIV8sVC--yp1u-_1_wWJmRFdc_INzmAobPhGyHkq0lgjoqkdQpE_POsNZO2pL19Z7XP00Ibc2bOZw"
          alt="Fabrizio"
          loading="lazy"
          class="w-full h-full object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700"
        />
        <div class="absolute inset-0 bg-linear-to-t from-background via-transparent to-transparent"></div>
      </div>
    </section>

    <!-- Filosofía -->
    <section>
      <div class="flex items-center gap-4 mb-10">
        <span class="w-10 h-0.5 bg-secondary shrink-0"></span>
        <h2
          class="text-3xl font-bold tracking-tight"
          data-i18n data-es={es['about.phil.title']} data-en={en['about.phil.title']}
        >
          {es['about.phil.title']}
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {[
          { titleKey: 'about.phil.1.title', descKey: 'about.phil.1.desc', icon: 'lightbulb' },
          { titleKey: 'about.phil.2.title', descKey: 'about.phil.2.desc', icon: 'speed' },
        ].map(({ titleKey, descKey, icon }) => (
          <div class="phil-card rounded-2xl ghost-border bg-surface-container-low">
            <div class="phil-card-content p-6 sm:p-10 flex flex-col justify-between h-full">
              <div>
                <h3
                  class="text-2xl font-bold text-on-surface mb-6"
                  data-i18n
                  data-es={es[titleKey as keyof typeof es]}
                  data-en={en[titleKey as keyof typeof en]}
                >
                  {es[titleKey as keyof typeof es]}
                </h3>
                <p
                  class="phil-subtitle text-on-surface-variant text-base leading-relaxed"
                  data-es={es[descKey as keyof typeof es]}
                  data-en={en[descKey as keyof typeof en]}
                >{es[descKey as keyof typeof es]}</p>
              </div>
              <span
                class="material-symbols-outlined phil-icon text-5xl mt-8 block"
                aria-hidden="true"
                style="font-variation-settings:'FILL' 1"
              >{icon}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <script>
      function initPhilCards(lang?: string) {
        const l = lang || localStorage.getItem('fabrizio-lang') || 'es';
        document.querySelectorAll('.phil-subtitle').forEach(el => {
          const text = el.getAttribute('data-' + l) || el.getAttribute('data-es') || '';
          // El espacio va fuera del span: dentro de un inline-block se recorta
          el.replaceChildren(...text.split(' ').flatMap((word: string, i: number) => {
            const span = document.createElement('span');
            span.className = 'phil-word';
            span.style.setProperty('--wd', `${i * 38}ms`);
            span.textContent = word;
            return i === 0 ? [span] : [document.createTextNode(' '), span];
          }));
        });
      }
      document.addEventListener('DOMContentLoaded', () => initPhilCards());
      document.addEventListener('astro:page-load', () => initPhilCards());
      document.addEventListener('fabrizio:langchange', (e: Event) => initPhilCards((e as CustomEvent).detail.lang));
    </script>

    <!-- Stack Técnico (Bento) -->
    <section class="space-y-8 md:space-y-12">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-2 md:gap-6">
        <h2
          class="text-3xl md:text-4xl font-black tracking-tighter uppercase"
          data-i18n data-es={es['skills.label']} data-en={en['skills.label']}
        >
          {es['skills.label']}
        </h2>
        <div
          class="text-xs md:text-sm tracking-widest text-on-surface-variant uppercase border-b border-outline-variant pb-2"
          data-i18n data-es={es['skills.subtitle']} data-en={en['skills.subtitle']}
        >
          {es['skills.subtitle']}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <!-- Frontend Architecture (grande) -->
        <div class="glass-effect rounded-xl p-6 md:p-8 flex flex-col justify-between ghost-border group hover:shadow-glow-soft transition-all duration-300">
          <div class="space-y-3">
            <span class="material-symbols-outlined text-4xl text-primary block" aria-hidden="true" style="font-variation-settings:'FILL' 1">layers</span>
            <h3
              class="text-2xl font-bold"
              data-i18n data-es={es['skills.frontend']} data-en={en['skills.frontend']}
            >
              {es['skills.frontend']}
            </h3>
            <p
              class="text-on-surface-variant text-sm leading-relaxed"
              data-i18n data-es={es['skills.designops.desc']} data-en={en['skills.designops.desc']}
            >
              {es['skills.designops.desc']}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 mt-6">
            {frontendTags.map(tag => <TechTag {...tag} />)}
          </div>
        </div>

        <!-- Backend -->
        <div class="glass-effect rounded-xl p-6 md:p-8 flex flex-col justify-between ghost-border group hover:shadow-glow-soft transition-all duration-300">
          <div class="space-y-3">
            <span class="material-symbols-outlined text-4xl text-secondary block" aria-hidden="true" style="font-variation-settings:'FILL' 1">terminal</span>
            <h3
              class="text-2xl font-bold"
              data-i18n data-es={es['skills.backend']} data-en={en['skills.backend']}
            >
              {es['skills.backend']}
            </h3>
            <p
              class="text-on-surface-variant text-sm leading-relaxed"
              data-i18n data-es={es['skills.backend.desc']} data-en={en['skills.backend.desc']}
            >
              {es['skills.backend.desc']}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 mt-6">
            {backendTags.map(tag => <TechTag {...tag} />)}
          </div>
        </div>

        <!-- Bases de datos -->
        <div class="glass-effect rounded-xl p-6 md:p-8 flex flex-col justify-between ghost-border group hover:shadow-glow-soft transition-all duration-300">
          <div class="space-y-3">
            <span class="material-symbols-outlined text-tertiary text-4xl block" aria-hidden="true" style="font-variation-settings:'FILL' 1">database</span>
            <h3
              class="text-2xl font-bold"
              data-i18n data-es={es['skills.databases']} data-en={en['skills.databases']}
            >
              {es['skills.databases']}
            </h3>
            <p
              class="text-on-surface-variant text-sm leading-relaxed"
              data-i18n data-es={es['skills.databases.desc']} data-en={en['skills.databases.desc']}
            >
              {es['skills.databases.desc']}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 mt-6">
            {databaseTags.map(tag => <TechTag {...tag} />)}
          </div>
        </div>

        <!-- Cloud & Tools -->
        <div class="glass-effect rounded-xl p-6 md:p-8 flex flex-col justify-between ghost-border group hover:shadow-glow-soft transition-all duration-300">
          <div class="space-y-3">
            <span class="material-symbols-outlined text-primary text-4xl block" aria-hidden="true" style="font-variation-settings:'FILL' 1">cloud</span>
            <h3
              class="text-2xl font-bold"
              data-i18n data-es={es['skills.cloud']} data-en={en['skills.cloud']}
            >
              {es['skills.cloud']}
            </h3>
            <p
              class="text-on-surface-variant text-sm leading-relaxed"
              data-i18n data-es={es['skills.cloud.desc']} data-en={en['skills.cloud.desc']}
            >
              {es['skills.cloud.desc']}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 mt-6">
            {cloudTags.map(tag => <TechTag {...tag} />)}
          </div>
        </div>

      </div>
    </section>

    <!-- Timeline -->
    <section class="max-w-3xl mx-auto space-y-12 md:space-y-20">
      <h2
        class="text-3xl md:text-4xl font-black tracking-tighter uppercase text-center"
        data-i18n data-es={es['about.journey.title']} data-en={en['about.journey.title']}
      >
        {es['about.journey.title']}
      </h2>

      <!-- Mobile timeline -->
      <ol class="md:hidden">
        {timeline.map((entry, i) => (
          <li class="grid grid-cols-[2rem_1fr]">
            <div class="flex flex-col items-center">
              <div class={`w-3 h-3 rounded-full shrink-0 mt-1.5 ${entry.active ? 'bg-primary shadow-glow-point' : 'bg-outline-variant'}`}></div>
              {i < timeline.length - 1 && (
                <div class="w-px flex-1 bg-linear-to-b from-primary/60 to-outline-variant/30 mt-1"></div>
              )}
            </div>
            <div class="pb-10 pl-2">
              <span class="text-secondary font-bold text-sm" data-i18n data-es={entry.period.es} data-en={entry.period.en}>{entry.period.es}</span>
              <h3 class="text-xl font-black mt-1 uppercase">{entry.role}</h3>
              <p class="text-primary text-xs font-bold tracking-wider uppercase mt-1 mb-3" data-i18n data-es={entry.company.es} data-en={entry.company.en}>{entry.company.es}</p>
              <p class="text-on-surface-variant text-base leading-relaxed" data-i18n data-es={entry.description.es} data-en={entry.description.en}>{entry.description.es}</p>
              <p class="mt-3 text-on-surface-variant text-xs font-medium tracking-wide">{entry.tech}</p>
            </div>
          </li>
        ))}
      </ol>

      <!-- Desktop timeline (zigzag) -->
      <div class="hidden md:block relative">
        <div aria-hidden="true" class="absolute left-1/2 top-0 bottom-0 w-px bg-linear-to-b from-primary via-outline-variant to-transparent -translate-x-1/2"></div>
      <ol class="space-y-16">

        {timeline.map((entry, i) => {
          const isEven = i % 2 === 0;
          const dotClass = `w-3 h-3 rounded-full shrink-0 ${entry.active ? 'bg-primary shadow-glow-point' : 'bg-outline-variant'}`;
          const metaBlock = (
            <div class={isEven ? 'text-right pr-8' : 'pl-8'}>
              <span class="text-secondary font-bold text-lg" data-i18n data-es={entry.period.es} data-en={entry.period.en}>{entry.period.es}</span>
              <h3 class="text-2xl font-black mt-2 uppercase">{entry.role}</h3>
              <p class="text-primary text-xs font-bold tracking-wider uppercase mt-1" data-i18n data-es={entry.company.es} data-en={entry.company.en}>{entry.company.es}</p>
            </div>
          );
          const detailsBlock = (
            <div class={isEven ? 'text-on-surface-variant leading-relaxed text-base pl-8' : 'text-on-surface-variant leading-relaxed text-base text-right pr-8'}>
              <p data-i18n data-es={entry.description.es} data-en={entry.description.en}>{entry.description.es}</p>
              <p class="mt-3 text-on-surface-variant text-xs font-medium tracking-wide">{entry.tech}</p>
            </div>
          );
          return (
            <li class="grid grid-cols-[1fr_2rem_1fr] items-start">
              {isEven ? (
                <>
                  {metaBlock}
                  <div class="flex justify-center pt-2"><div class={dotClass}></div></div>
                  {detailsBlock}
                </>
              ) : (
                <>
                  {detailsBlock}
                  <div class="flex justify-center pt-2"><div class={dotClass}></div></div>
                  {metaBlock}
                </>
              )}
            </li>
          );
        })}
      </ol>
      </div>
    </section>

    </div>
  </main>

  <BottomNav />
  <Footer />
</Layout>
